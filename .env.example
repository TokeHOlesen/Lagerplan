# Copy this file to .env and adjust. Never commit .env to git.

# Development: DJANGO_DEBUG=1. Production: DJANGO_DEBUG=0 and a real secret key.
DJANGO_DEBUG=1

# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Comma-separated host names the site is served under.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional overrides (defaults: db.sqlite3 and rates.toml in the project folder).
# DJANGO_DB_PATH=/srv/lagerplan/db.sqlite3
# WORKLOAD_RATES_PATH=/srv/lagerplan/rates.toml
